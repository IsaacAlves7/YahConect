# ── Banco de dados ──────────────────────────────────────────────
# SQLite (padrão, ótimo para testes locais):
DATABASE_URL=sqlite:///./yahconect.db

# PostgreSQL (produção):
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/yahconect

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────
# Criado em https://developers.facebook.com/apps -> WhatsApp -> API Setup
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-secreto-seu
WHATSAPP_ACCESS_TOKEN=coloque-aqui-o-token-de-acesso-da-meta
WHATSAPP_PHONE_NUMBER_ID=coloque-aqui-o-phone-number-id

# ── App ──────────────────────────────────────────────────────────
APP_NAME=YahConect
TIMEZONE=America/Sao_Paulo
